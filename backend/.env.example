# ===================================
# PRÉSTAMOS LUCHO - Configuración
# ===================================

# Entorno
NODE_ENV=production

# Servidor
PORT=3000
HOST=0.0.0.0

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://lucho_user:tu_password_seguro@localhost:5432/prestamos_lucho?schema=public"

# Alternativa: MySQL
# DATABASE_URL="mysql://lucho_user:tu_password_seguro@localhost:3306/prestamos_lucho"

# JWT
JWT_SECRET=cambia_este_secreto_por_uno_muy_seguro_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Google
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# CORS
CORS_ORIGIN=http://localhost:5173,https://tudominio.com

# Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@prestamoslucho.com
SMTP_PASS=tu_password_email

# Twilio (SMS - opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS S3 (Almacenamiento de documentos - opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=prestamos-lucho-docs

# Configuración de Aplicación
DEFAULT_LANGUAGE=es
DEFAULT_CURRENCY=PEN
DEFAULT_INTEREST_RATE=5.0
DEFAULT_LATE_FEE_RATE=2.0
DEFAULT_GRACE_PERIOD_DAYS=3

# Seguridad
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# 2FA
ENABLE_2FA=false
OTP_SECRET_LENGTH=32

# Pagos (Stripe - opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Desarrollo
DEBUG=false
